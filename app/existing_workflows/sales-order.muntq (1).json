      "laneKey": "true",
      "note": null,
      "name": "Group by location (SO-1, SO-2…)",
      "config": {
        "mode": "Run Once for Each Item",
        "jsCode": "// One sales order per PO + supplier + location: SO-1, SO-2, … in the order they appear.\nconst lines = $json.Intelligence?.Json ?? [];\nconst numbers = new Map();\n\nconst rows = lines.map((line) => {\n  const key = [line.poRef, line.suppName, line.location].join('|');\n  if (!numbers.has(key)) numbers.set(key, `SO-${numbers.size + 1}`);\n  return { saleNo: numbers.get(key), ...line };\n});\n\n// One item holding every line, so SAP receives the whole batch in one call.\nreturn [{ json: { Rows: rows, SalesOrders: numbers.size } }];\n",
        "language": "JavaScript"
      },
      "credentialType": null
    },
