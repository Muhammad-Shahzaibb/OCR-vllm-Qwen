      "name": "Read the purchase order",
      "config": {
        "schema": "{\n  \"type\": \"array\",\n  \"items\": {\n    \"type\": \"object\",\n    \"properties\": {\n      \"poRef\": {\n        \"type\": \"string\"\n      },\n      \"suppName\": {\n        \"type\": \"string\"\n      },\n      \"location\": {\n        \"type\": \"string\"\n      },\n      \"material\": {\n        \"type\": \"string\"\n      },\n      \"dept\": {\n        \"type\": \"string\"\n      },\n      \"uom\": {\n        \"type\": \"string\"\n      },\n      \"qty\": {\n        \"type\": \"string\"\n      },\n      \"comments\": {\n        \"type\": \"string\"\n      }\n    },\n    \"required\": [\n      \"poRef\",\n      \"suppName\",\n      \"location\",\n      \"material\",\n      \"dept\",\n      \"uom\",\n      \"qty\",\n      \"comments\"\n    ],\n    \"additionalProperties\": false\n  }\n}\n",
        "instruction": "\nExtract every PO line item from the PDF.\n\n- poRef: Purchase Order # from the header.\n- suppName: Supplier Name from the header.\n- location: Location from the corresponding header section. If multiple location sections exist, use the location belonging to that line item.\n- material: Material code from Item Description, extracted as the value before \"--\". Do not use Item #.\n- dept: Dept from the line-item row.\n- uom: UOM from the line-item row.\n- qty: Qty from the line-item row.\n- comments: Comments from the corresponding PO header.\n\nRepeat the header values for every line item under that header.\nDo not omit, merge, duplicate, or invent line items.\nReturn valid JSON only, matching the schema below.",
        "attachmentKey": "",
        "failOnInvalidSchema": false
      },
      "credentialType": null
    },
