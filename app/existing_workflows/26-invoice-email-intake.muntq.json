      "nodeTypeId": "muntq.ai-operation",
      "position": 1,
      "x": 420,
      "y": 120,
      "name": "Extract invoice details",
      "config": {
        "inputType": "File",
        "operation": "Extract",
        "attachmentKey": "attachment_1",
        "sourceText": "",
        "schema": "{\n  \"type\": \"object\",\n  \"properties\": {\n    \"invoice_number\": { \"type\": \"string\" },\n    \"supplier\": { \"type\": \"string\" },\n    \"amount\": { \"type\": \"number\" },\n    \"currency\": { \"type\": \"string\" },\n    \"due_date\": { \"type\": \"string\" },\n    \"route\": { \"type\": \"string\", \"enum\": [\"finance review\", \"routine verification\"] }\n  },\n  \"required\": [\"invoice_number\", \"supplier\", \"amount\", \"currency\", \"due_date\", \"route\"]\n}",
        "instruction": "Read the attached invoice and extract the requested fields. Route to finance review if a required value is missing, unclear, or the amount exceeds 5000 in the stated currency. Otherwise route to routine verification. Never approve or pay an invoice.",
        "labels": "",
        "style": "",
        "failOnInvalidSchema": true
      }
    },
