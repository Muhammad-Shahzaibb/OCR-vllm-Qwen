      "nodeTypeId": "code.run-code",
      "position": 1,
      "x": 420,
      "y": 120,
      "name": "Apply the demo review policy",
      "config": {
        "mode": "Run Once for Each Item",
        "language": "JavaScript",
        "jsCode": "const amount = Number($json.Form.Amount);\nconst purpose = String($json.Form.BusinessPurpose || '').trim();\nconst needsReview = amount > 250 || purpose.length < 20;\nconst reason = amount > 250\n  ? 'Amount exceeds the demo threshold of 250 USD.'\n  : purpose.length < 20\n    ? 'Business purpose needs more detail.'\n    : 'Claim is within the demo routing checks.';\nreturn [{\n  json: {\n    ...$json,\n    ReviewRoute: needsReview ? 'manager review' : 'routine queue',\n    ReviewReason: reason\n  }\n}];"
      }
    },
    {
      "key": "review-gate",
      "nodeTypeId": "flow-control.if",
      "position": 2,
      "x": 760,
      "y": 120,
      "name": "Does this claim need a manager?",
      "config": {
        "conditions": [
          {
            "combinator": "AND",
            "rules": [
              {
                "left": "{{node:policy-check/ReviewRoute}}",
                "operator": "is equal to",
                "right": "manager review"
              }
            ]
          }
        ]
      }
    },
    {
      "key": "manager-approval",
      "nodeTypeId": "flow-control.wait",
      "position": 3,
      "x": 1100,
      "y": 40,
      "laneKey": "true",
      "name": "Manager decides on the claim",
      "config": {
        "mode": "Until resumed",
        "notifyEmail": "reviewer@example.invalid",
        "approvalMessage": "Review this expense claim and the MUNTQ Intelligence recommendation. This demo does not issue a reimbursement.",
        "approvalFields": "Form.Employee, Form.WorkEmail, Form.Amount, Form.Merchant, Form.BusinessPurpose, ReviewReason"
      }
    },
    {
      "key": "record-decision",
      "nodeTypeId": "transform.edit-fields",
      "position": 4,
